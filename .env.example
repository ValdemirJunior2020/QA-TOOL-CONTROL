# Browser-safe value. Create a Google Web OAuth client ID for Sign in with Google.
VITE_GOOGLE_CLIENT_ID=PASTE_GOOGLE_WEB_CLIENT_ID_HERE

# Keep false in production. Change to true only for local testing with `netlify dev`.
VITE_ENABLE_DEV_LOGIN=false

# Server-only Netlify environment variables. Never prefix these with VITE_.
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID_HERE/exec
APPS_SCRIPT_API_KEY=b3ab35174e973e9a2691537ddfe76660dea5516b114c70de3e9b5c19bbae0aaf
GOOGLE_CLIENT_ID=PASTE_GOOGLE_WEB_CLIENT_ID_HERE
QA_APP_PROXY_SECRET=PASTE_THE_SECRET_CREATED_BY_qaAppSetup_HERE
ALLOW_DEV_BYPASS=false
